# Copy this file to .env and replace every placeholder before starting.
# Keep .env private; it contains the gateway and upstream credentials.

KIRO_CLIENT_API_KEY=client-key-change-me
# Optional: also set KIRO_ADMIN_ENABLED=true (or config.json admin.enabled=true).
KIRO_ADMIN_API_KEY=admin-key-change-me

# The Compose template uses environment-variable credentials by default.
KIRO_CREDENTIAL_SOURCE=env

# Set one upstream credential kind. Access/refresh tokens cannot be combined
# with KIRO_API_KEY. Replace the example value with a real provider value.
KIRO_ACCESS_TOKEN=access-token-from-your-provider
# KIRO_REFRESH_TOKEN=refresh-token-from-your-provider
# KIRO_API_KEY=upstream-api-key-from-your-provider

# Optional metadata used by API-key or OIDC credentials.
# KIRO_API_REGION=us-east-1
# KIRO_ENDPOINT=auto
# KIRO_CLIENT_ID=oidc-client-id
# KIRO_CLIENT_SECRET=oidc-client-secret
# KIRO_MACHINE_ID=machine-id
