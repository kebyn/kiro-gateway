# Copy this file to .env and replace every placeholder before starting.
# Keep .env private; it contains the gateway and upstream credentials.

KIRO__ACCESS__CLIENT_API_KEY=client-key-change-me
# Optional: also set KIRO__ADMIN__ENABLED=true (or config.json admin.enabled=true).
KIRO__ADMIN__API_KEY=admin-key-change-me

# The Compose template uses environment-variable credentials by default.
KIRO__CREDENTIAL__SOURCE=env

# Set one upstream credential kind. Access/refresh tokens cannot be combined
# with KIRO__CREDENTIAL__API_KEY. Replace the example value with a real provider value.
KIRO__CREDENTIAL__ACCESS_TOKEN=access-token-from-your-provider
# KIRO__CREDENTIAL__REFRESH_TOKEN=refresh-token-from-your-provider
# KIRO__CREDENTIAL__API_KEY=upstream-api-key-from-your-provider

# Optional metadata used by API-key or OIDC credentials.
# KIRO__UPSTREAM__API_REGION=us-east-1
# KIRO__UPSTREAM__ENDPOINT=auto
# KIRO__CREDENTIAL__CLIENT_ID=oidc-client-id
# KIRO__CREDENTIAL__CLIENT_SECRET=oidc-client-secret
# KIRO__CREDENTIAL__MACHINE_ID=machine-id
